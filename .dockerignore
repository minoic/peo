# Repository metadata and developer tooling
.git
.github
.idea
.vscode
.run
*.iml

# Local credentials and configuration
**/.env
**/.env.*
**/secrets.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
server/conf
pterodactyl/wings/config.yml

# Local build output and caches
build
dist
tmp
.tmp
.cache
coverage
*.log
server/bin
server/cmd/peo/__debug_bin*
flutter/.dart_tool
flutter/.idea
flutter/build
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/android
flutter/ios
flutter/linux
flutter/macos
flutter/windows
pterodactyl/wings/wings_linux_*
pterodactyl/*.pteroext

# Flutter is built in stage 1 and copied into the Go build stage.
# Keep .gitkeep so `//go:embed all:assets` has its source directory.
server/web/assets/*
!server/web/assets/.gitkeep

# Documentation is not needed to build the runtime image.
docs
